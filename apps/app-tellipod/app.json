{
  "expo": {
    "name": "Tellipod",
    "slug": "mee-tellipod",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "meetellipod",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mee.tellipod"
    },
    "android": {
      "package": "com.mee.tellipod"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
