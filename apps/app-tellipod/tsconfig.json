{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@mee/core": ["../../packages/core/src/index.ts"],
      "@mee/core/*": ["../../packages/core/src/*"],
      "@mee/ui": ["../../packages/ui/src/index.ts"],
      "@mee/ui/*": ["../../packages/ui/src/*"]
    },
    "strict": true,
    "types": ["jest"]
  },
  "extends": "expo/tsconfig.base",
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
