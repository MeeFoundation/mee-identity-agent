{
  "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [[":URL:", ":NODE:"], ":BLANK_LINE:", [":PACKAGE:"], ":BLANK_LINE:", ":PATH:"]
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "extends": "//",
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/dist", "!**/ios", "!**/.expo", "!**/expo-env.d.ts", "!**/.rnstorybook"]
  },
  "root": false
}
