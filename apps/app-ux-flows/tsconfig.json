{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/app/*": ["./src/app/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/slices/*": ["./src/slices/*"],
      "@/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
