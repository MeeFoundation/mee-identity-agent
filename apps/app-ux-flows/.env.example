# Flow analytics. Copy to `.env.local` (not committed) and fill in real values.
# The deployed container reads the same variables at startup; see DEPLOYMENT.md.

# Master switch. Defaults to `true`; set to `false` to load no analytics at all.
VITE_ANALYTICS_ENABLED=

# Write every analytics event to the browser console outside development builds. Defaults to `false`.
# Development builds always log to the console.
VITE_ANALYTICS_DEBUG=

# Matomo base URL, e.g. https://matomo.example.com/. Matomo is used only when both URL and site id are set.
VITE_MATOMO_URL=

# Matomo site id (integer).
VITE_MATOMO_SITE_ID=

# Ids of the action-scoped custom dimensions created in Matomo (integers).
# A dimension without an id is not sent.
VITE_MATOMO_DIMENSION_FLOW_ID=
VITE_MATOMO_DIMENSION_VARIANT_ID=
VITE_MATOMO_DIMENSION_RUN_ID=
VITE_MATOMO_DIMENSION_SCREEN_ID=
VITE_MATOMO_DIMENSION_VARIANT_SOURCE=
