{
  "name": "mee-react-native-smartwallet",
  "private": true,
  "scripts": {
    "lint": "biome lint --error-on-warnings ./packages ./apps",
    "check-types": "pnpm -r --parallel exec tsc --noEmit",
    "concepts:ios": "pnpm --filter app-concepts ios",
    "concepts:android": "pnpm --filter app-concepts android",
    "production:ios": "pnpm --filter app-production ios",
    "production:android": "pnpm --filter app-production android",
    "tellipod:ios": "pnpm --filter app-tellipod ios",
    "tellipod:android": "pnpm --filter app-tellipod android",
    "tellipod:storybook:android": "pnpm --filter app-tellipod storybook:android",
    "tellipod:storybook:ios": "pnpm --filter app-tellipod storybook:ios",
    "ux-flows:dev": "pnpm --filter app-ux-flows dev",
    "steiger:concepts": "pnpm --filter app-concepts steiger:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.13.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {
    "patchedDependencies": {
      "@react-native-menu/menu@1.2.2": "patches/@react-native-menu__menu@1.2.2.patch"
    }
  }
}
